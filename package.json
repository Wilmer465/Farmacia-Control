{
  "name": "farmacia-control",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Sistema de gestión y trazabilidad de medicamentos - Fase 1",
  "main": "electron/main.js",
  "author": "Wilmer",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "node scripts/start-electron.js",
    "dev:wait-electron": "wait-on tcp:5173 && node scripts/start-electron.js",
    "dev": "concurrently -k --names vite,electron --success command-electron \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "build:react": "vite build",
    "build": "vite build && electron-builder",
    "prebuild": "node scripts/compilar-stu-bridge.js && node scripts/compilar-zk-bridge.js",
    "compilar:stu-bridge": "node scripts/compilar-stu-bridge.js",
    "compilar:zk-bridge": "node scripts/compilar-zk-bridge.js",
    "migrate": "node backend/database/migrate.js",
    "seed": "node backend/database/seeds/seed.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:db": "node --test tests/database/**/*.test.js",
    "test:ipc": "node --test tests/ipc/**/*.test.js",
    "test:security": "node --test tests/security/**/*.test.js",
    "test:rules": "node --test tests/business-rules/**/*.test.js",
    "test:sync": "node --test tests/sync-offline/**/*.test.js",
    "test:reports": "node --test tests/reports/**/*.test.js",
    "test:hardware": "node --test tests/hardware/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "test:dian:electron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-dian-integration-tests.ps1",
    "lint": "eslint backend electron shared scripts",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild --force --which-module better-sqlite3 --version 32.3.3",
    "postinstall": "electron-rebuild --force --which-module better-sqlite3 --version 32.3.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "libxml2-wasm": "^0.7.2",
    "node-forge": "^1.4.0",
    "pkijs": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xadesjs": "^2.6.8",
    "xml-crypto": "^6.1.2",
    "xmldsigjs": "^2.8.8",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.6",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.farmacia.control",
    "productName": "Farmacia Control",
    "files": [
      "dist/renderer/**/*",
      "!dist/win-unpacked/**",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/latest.yml",
      "!dist/builder-debug.yml",
      "electron/**/*",
      "backend/**/*",
      "shared/**/*"
    ],
    "extraResources": [
      {
        "from": "native/stu-bridge/bin",
        "to": "native/stu-bridge"
      },
      {
        "from": "native/zk-bridge/bin",
        "to": "native/zk-bridge"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "include": "build/installer-bridge-prerequisites.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
